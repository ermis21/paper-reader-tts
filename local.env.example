# Copy to `local.env` (gitignored) and edit. ./start.sh sources it.
# Nothing here is read unless you create that file.

# Bind address. The shipped default is 127.0.0.1 and you should leave it there
# unless you have read SECURITY.md: the app is unauthenticated, and an upload
# starts a subprocess pipeline. 0.0.0.0 exposes it to every host that can reach
# this machine -- fine on a private VPN you control, never on the open internet
# and never via a port forwarded from a router.
#PA_HOST=0.0.0.0

# Port. 3002 by default.
#PA_PORT=3002

# CPU-only is a design constraint, not a preference: Kokoro renders at
# 3.3-3.7x realtime on CPU, and keeping it off the GPU means a long batch
# render never fights whatever else on the machine wants the card.
#CUDA_VISIBLE_DEVICES=

# Synthesis threads. Roughly "physical cores you are willing to donate".
#OMP_NUM_THREADS=6

# Where Kokoro's model weights are cached.
#HF_HOME=/home/you/.cache/huggingface
